{
  "enforce-agents-read": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/hooks/pre_invocation_check_agents.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/pre_tool_check_agents.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "auto-coder-reviewer-loop": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/hooks/stop_auto_review.py",
        "timeout": 1500
      }
    ]
  }
}
