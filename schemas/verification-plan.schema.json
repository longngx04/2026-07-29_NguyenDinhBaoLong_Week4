{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationCandidate",
  "description": "Schema for a single verification candidate record in Project Sentinel (Week 4)",
  "type": "object",
  "required": [
    "candidate_id",
    "analysis_record_id",
    "group_id",
    "cwe",
    "decision",
    "endpoint_id",
    "template_id",
    "method",
    "path"
  ],
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_record_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "cwe": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["PLANNED", "NOT_PLANNABLE"]
    },
    "endpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"]
    },
    "path": {
      "type": "string"
    },
    "target_field": {
      "type": ["string", "null"]
    },
    "payload_type": {
      "type": ["string", "null"]
    },
    "reason": {
      "type": ["string", "null"]
    }
  }
}
