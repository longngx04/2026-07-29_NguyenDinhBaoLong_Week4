{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationPlan",
  "description": "Schema for a single verification plan record in Project Sentinel (Week 4)",
  "type": "object",
  "required": [
    "plan_id",
    "analysis_record_id",
    "group_id",
    "cwe",
    "target_url",
    "probes"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_record_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "cwe": {
      "type": "string",
      "minLength": 1
    },
    "target_url": {
      "type": "string",
      "pattern": "^http://(127\\.0\\.0\\.1|localhost):8080/.*$"
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "probe_id",
          "method",
          "path",
          "headers",
          "params",
          "expected_status"
        ],
        "additionalProperties": false,
        "properties": {
          "probe_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"]
          },
          "path": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "expected_indicator": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
