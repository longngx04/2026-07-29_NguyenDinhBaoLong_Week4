{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecurityAnalysisRecord",
  "description": "Schema for a single analyzed finding group record in Project Sentinel",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "group_key",
    "source_finding_ids",
    "title",
    "severity",
    "reachability",
    "attacker_control",
    "disposition",
    "scanner_severities",
    "confidence",
    "confidence_rationale",
    "locations",
    "cwe",
    "owasp",
    "evidence",
    "explanation",
    "preconditions",
    "verification_steps",
    "remediation",
    "knowledge_refs",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^analysis-[a-f0-9-]+$"
    },
    "group_key": {
      "type": "string",
      "minLength": 1
    },
    "source_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "scanner_severities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "confidence_rationale": {
      "type": "string",
      "minLength": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "file",
              "line"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "description": "Vi tri runtime cua mot finding DAST. Phai co that trong input.",
                "type": "string",
                "minLength": 1
              },
              "method": { "type": "string" },
              "param": { "type": ["string", "null"] }
            }
          }
        ]
      },
      "minItems": 1
    },

    "cwe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owasp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "finding_id",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "scanner"
              },
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "path",
              "start_line",
              "end_line",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "source"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_steps": {
      "description": "Buoc kiem chung, dang co cau truc. `action` la tap dong. Free text tung cho phep payload thuc thi lot vao deliverable: artifact da commit chua \"'; DROP TABLE employees --'\" va \"ping localhost; id\". Tap dong dong lai duong do o tang schema, khong chi bang loi dan trong prompt.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "review_source",
              "write_unit_test",
              "inspect_configuration",
              "check_dependency_version",
              "send_benign_template",
              "manual_code_review"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Mo ta viec can lam. KHONG chua payload, lenh shell hay chuoi khai thac."
          }
        }
      }
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_objective": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "description",
            "endpoint_hint",
            "payload_kind",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "endpoint_hint": {
              "type": "string",
              "pattern": "^(GET|POST) /[^ ?]*$"
            },
            "payload_kind": {
              "type": "string",
              "enum": [
                "long_string",
                "special_chars",
                "empty_value",
                "wrong_type"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "expected_signal": {
              "description": "Tuy chon. Chuoi can quan sat trong response de ket luan supports/refutes. Khong khai thi ket qua probe luon la inconclusive. Chi dung de so khop chuoi con voi response, khong bao gio duoc thuc thi.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            }
          }
        }
      ]
    },
    "disposition": {
      "description": "Ket luan cua Agent ve finding, tach roi khoi severity cua scanner.",
      "type": "string",
      "enum": [
        "confirmed",
        "likely",
        "needs_review",
        "false_positive"
      ]
    },
    "attacker_control": {
      "description": "Du lieu toi sink co do ke tan cong kiem soat khong, theo bang chung da cung cap.",
      "type": "string",
      "enum": [
        "proven",
        "not_proven",
        "not_applicable"
      ]
    },
    "reachability": {
      "description": "Doan ma co dat toi duoc tu mot duong vao khong, theo bang chung da cung cap.",
      "type": "string",
      "enum": [
        "proven",
        "not_proven",
        "not_applicable"
      ]
    },
    "calibration": {
      "description": "Vet hieu chinh do tang Python ap len output cua Agent. Agent KHONG duoc sinh truong nay; moi gia tri do Agent khai deu bi bo di truoc khi hieu chinh.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "rules",
            "severity_from",
            "severity_to",
            "disposition_from",
            "disposition_to"
          ],
          "additionalProperties": false,
          "properties": {
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "severity_from": {
              "type": [
                "string",
                "null"
              ]
            },
            "severity_to": {
              "type": [
                "string",
                "null"
              ]
            },
            "disposition_from": {
              "type": [
                "string",
                "null"
              ]
            },
            "disposition_to": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
